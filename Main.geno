/// Convert non-negative integers between base 10 and bases 2..16 (lowercase digits).

import String

func digit_char(d: Int) -> String
    example 0 -> "0"
    example 9 -> "9"
    example 10 -> "a"
    example 15 -> "f"
    if d < 10 then
        return to_string(d)
    else if d == 10 then
        return "a"
    else if d == 11 then
        return "b"
    else if d == 12 then
        return "c"
    else if d == 13 then
        return "d"
    else if d == 14 then
        return "e"
    else
        return "f"
    end if
end func

func char_digit(c: String) -> Option[Int]
    example "0" -> Some(0)
    example "9" -> Some(9)
    example "a" -> Some(10)
    example "f" -> Some(15)
    example "A" -> Some(10)
    example "g" -> None
    let lower: String = to_lower(c)
    if lower >= "0" and lower <= "9" then
        return Some(char_code(lower) - char_code("0"))
    else if lower >= "a" and lower <= "f" then
        return Some(10 + (char_code(lower) - char_code("a")))
    else
        return None
    end if
end func

func to_base(n: Int, base: Int) -> Result[String, String]
    example 255, 16 -> Ok("ff")
    example 10, 2 -> Ok("1010")
    example 0, 10 -> Ok("0")
    example 42, 10 -> Ok("42")
    example 15, 8 -> Ok("17")
    example 13, 16 -> Ok("d")
    example (-1), 10 -> Err("n must be non-negative")
    example 5, 1 -> Err("base must be 2..16")
    example 5, 17 -> Err("base must be 2..16")
    if n < 0 then
        return Err("n must be non-negative")
    end if
    if base < 2 or base > 16 then
        return Err("base must be 2..16")
    end if
    if n == 0 then
        return Ok("0")
    end if
    var x: Int = n
    var digits: String = ""
    while x > 0 do
        digits = digit_char(x % base) + digits
        x = x / base
    end while
    return Ok(digits)
end func

func from_base(s: String, base: Int) -> Result[Int, String]
    example "ff", 16 -> Ok(255)
    example "1010", 2 -> Ok(10)
    example "0", 10 -> Ok(0)
    example "17", 8 -> Ok(15)
    example "d", 16 -> Ok(13)
    example "", 10 -> Err("empty string")
    example "2", 2 -> Err("invalid digit")
    example "10", 1 -> Err("base must be 2..16")
    if base < 2 or base > 16 then
        return Err("base must be 2..16")
    end if
    if length(s) == 0 then
        return Err("empty string")
    end if
    var result: Int = 0
    var i: Int = 0
    while i < length(s) do
        let c: String = char_at(s, i)
        match char_digit(c) with
        | None -> return Err("invalid digit")
        | Some(v) ->
            if v >= base then
                return Err("invalid digit")
            end if
            result = result * base + v
        end match
        i = i + 1
    end while
    return Ok(result)
end func

@untested("entry point")
func main() -> String
    match to_base(n: 255, base: 16) with
    | Ok(h) ->
        match from_base(s: h, base: 16) with
        | Ok(v) -> return "255->16:" + h + "->" + to_string(v)
        | Err(e) -> return "from err: " + e
        end match
    | Err(e) -> return "to err: " + e
    end match
end func
